# Shopify app credentials (Dev Dashboard > your app > Settings: Client ID and secret).
# Never commit real values. `shopify app dev` sets these for you locally.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public HTTPS URL of this app (ngrok/cloudflared tunnel in development).
# Must match application_url in shopify.app.toml (without the /app path).
APP_URL=https://your-app.example.com

# Optional overrides
PORT=3055
SHOPIFY_API_VERSION=2026-07
CONFERBOT_WIDGET_URL=https://cdn.conferbot.com/dist/v1/widget.min.js
# DATA_FILE=./data/shops.json
